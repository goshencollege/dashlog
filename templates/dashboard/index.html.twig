{% extends 'base.html.twig' %}

{% block title %}Logs{% endblock %}
{% block body_class %}page-list-view{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css">
{% endblock %}

{% block page_styles %}
<style>
    .live-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: #198754;
        margin-right: 4px;
        animation: live-pulse 1.5s ease-in-out infinite;
    }
    @keyframes live-pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: .3; }
    }
    .log-live-row {
        animation: log-row-highlight 2s ease-out;
    }
    @keyframes log-row-highlight {
        0% { background-color: rgba(25, 135, 84, .15); }
        100% { background-color: transparent; }
    }

    /* TomSelect ships a light-only theme; retarget its hardcoded colors at
       Bootstrap's own CSS variables so it follows dark mode and the
       purple/green/rainbow accent themes instead of fighting them. */
    .ts-dropdown,
    .ts-control,
    .ts-control input {
        color: var(--bs-body-color);
    }
    .ts-control {
        background-color: var(--bs-body-bg);
    }
    .ts-control input::placeholder {
        color: var(--bs-secondary-color);
    }
    .ts-dropdown {
        border-color: var(--bs-border-color);
    }
    .ts-dropdown .optgroup-header {
        color: var(--bs-secondary-color);
    }
    .ts-wrapper.multi .ts-control > div {
        background: var(--bs-tertiary-bg);
        color: var(--bs-body-color);
        border-color: var(--bs-border-color);
    }
    .ts-wrapper.multi .ts-control > div.active {
        background: var(--bs-primary);
        color: #fff;
    }
    .ts-wrapper.plugin-remove_button .item .remove {
        border-left-color: var(--bs-border-color);
    }
    .ts-wrapper.plugin-remove_button .item .remove:hover {
        background: rgba(var(--bs-body-color-rgb), .08);
    }
    .focus .ts-control {
        border-color: var(--bs-primary);
        box-shadow: 0 0 0 .25rem rgba(var(--bs-primary-rgb), .25);
    }
</style>
{% endblock %}

{% block content %}
<div class="list-page-content">
    <div class="sticky-list-header">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h1 class="h3 mb-0"><i class="bi bi-clipboard-data-fill me-2"></i>Logs</h1>
            <div class="d-flex align-items-center gap-3">
                {% if page == 1 and not usingArchive %}
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="live-toggle">
                    <label class="form-check-label small" for="live-toggle">
                        <span id="live-indicator" class="d-none"><span class="live-dot"></span></span>Live
                    </label>
                </div>
                {% endif %}
                <span class="text-muted small"><span id="entry-count-number">{{ total }}</span> matching {{ total == 1 ? 'entry' : 'entries' }}</span>
            </div>
        </div>

        {% if usingArchive %}
        <div class="alert alert-info py-2 small mb-3" role="alert">
            <i class="bi bi-archive me-1"></i>
            Some of these results were reconstructed from storage — this query is slower than normal browsing.
        </div>
        {% endif %}

        <form method="get" class="row g-2 mb-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label small mb-1">Source</label>
                <select id="source-select" name="source[]" multiple class="form-select form-select-sm">
                    {% for source in filters.source %}
                        <option value="{{ source }}" selected>{{ source }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">Severity</label>
                <select id="severity-select" name="severity[]" multiple class="form-select form-select-sm">
                    {% for severity in severities %}
                        <option value="{{ severity.value }}" {{ severity.value in filters.severity ? 'selected' }}>{{ severity.label() }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">Message contains</label>
                <input type="text" name="q" value="{{ filters.q }}" class="form-control form-control-sm" placeholder="search text">
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">From</label>
                <input type="datetime-local" name="from" value="{{ filters.from }}" class="form-control form-control-sm">
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">To</label>
                <input type="datetime-local" name="to" value="{{ filters.to }}" class="form-control form-control-sm">
            </div>
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-primary flex-fill" title="Search"><i class="bi bi-search"></i></button>
                <a href="{{ path('dashboard') }}" class="btn btn-sm btn-outline-secondary" title="Clear filters"><i class="bi bi-x-lg"></i></a>
            </div>
        </form>
    </div>

    <div class="list-scroll-card">
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead>
                        <tr>
                            <th style="white-space:nowrap;">Time</th>
                            <th>Severity</th>
                            <th>Source</th>
                            <th>App</th>
                            <th>PID</th>
                            <th>Facility</th>
                            <th>Message</th>
                        </tr>
                    </thead>
                    <tbody id="log-table-body">
                        {% if entries is empty %}
                        <tr id="no-entries-row">
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox display-4 mb-3 d-block"></i>
                                No log entries match these filters.
                            </td>
                        </tr>
                        {% else %}
                            {% for entry in entries %}
                            <tr>
                                <td class="text-muted small" style="white-space:nowrap;">{{ entry.timestamp|date('Y-m-d H:i:s') }}</td>
                                <td>
                                    <span class="badge {{ syslog_severity_badge_class(entry.severity) }}">
                                        {{ syslog_severity_label(entry.severity) }}
                                    </span>
                                </td>
                                <td class="fw-semibold">{{ entry.source }}</td>
                                <td>{{ entry.appName ?? '—' }}</td>
                                <td class="text-muted">{{ entry.procId ?? '—' }}</td>
                                <td class="text-muted small">{{ syslog_facility_label(entry.facility) }}</td>
                                <td class="font-monospace small" style="white-space:pre-wrap;">{{ entry.message }}</td>
                            </tr>
                            {% endfor %}
                        {% endif %}
                    </tbody>
                </table>
            </div>
            {% if totalPages > 1 %}
            <div class="card-footer d-flex align-items-center justify-content-between">
                <span class="text-muted small">Page {{ page }} of {{ totalPages }}</span>
                <div class="d-flex gap-2">
                    <a href="{{ path('dashboard', filters|merge({page: max(1, page - 1)})) }}"
                       class="btn btn-sm btn-outline-secondary {{ page <= 1 ? 'disabled' }}">
                        <i class="bi bi-chevron-left"></i> Newer
                    </a>
                    <a href="{{ path('dashboard', filters|merge({page: min(totalPages, page + 1)})) }}"
                       class="btn btn-sm btn-outline-secondary {{ page >= totalPages ? 'disabled' }}">
                        Older <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
            </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
<script>
(function () {
    new TomSelect('#source-select', {
        plugins: ['remove_button'],
        valueField: 'source',
        labelField: 'source',
        searchField: 'source',
        create: false,
        maxOptions: 50,
        preload: true,
        load: function (query, callback) {
            fetch('{{ path('log_sources') }}?q=' + encodeURIComponent(query))
                .then(function (response) { return response.json(); })
                .then(function (sources) { callback(sources.map(function (s) { return {source: s}; })); })
                .catch(function () { callback(); });
        },
    });
    new TomSelect('#severity-select', {
        plugins: ['remove_button'],
        create: false,
    });
})();
</script>
{% if page == 1 and not usingArchive %}
<script>
(function () {
    var toggle = document.getElementById('live-toggle');
    var indicator = document.getElementById('live-indicator');
    var tbody = document.getElementById('log-table-body');
    var countEl = document.getElementById('entry-count-number');

    var lastId = {{ latestEntryId }};
    var currentFilters = {
        source: {{ filters.source|json_encode|raw }},
        severity: {{ filters.severity|json_encode|raw }},
        q: {{ filters.q|json_encode|raw }},
        from: {{ filters.from|json_encode|raw }},
        to: {{ filters.to|json_encode|raw }}
    };
    var pollTimer = null;
    var maxRows = 200;

    function escapeHtml(value) {
        var div = document.createElement('div');
        div.textContent = value === null || value === undefined ? '' : value;
        return div.innerHTML;
    }

    function buildRow(entry) {
        var tr = document.createElement('tr');
        tr.className = 'log-live-row';
        tr.innerHTML =
            '<td class="text-muted small" style="white-space:nowrap;">' + escapeHtml(entry.timestamp) + '</td>' +
            '<td><span class="badge ' + entry.severityBadgeClass + '">' + entry.severityLabel + '</span></td>' +
            '<td class="fw-semibold">' + escapeHtml(entry.source) + '</td>' +
            '<td>' + escapeHtml(entry.appName || '—') + '</td>' +
            '<td class="text-muted">' + escapeHtml(entry.procId || '—') + '</td>' +
            '<td class="text-muted small">' + escapeHtml(entry.facilityLabel) + '</td>' +
            '<td class="font-monospace small" style="white-space:pre-wrap;">' + escapeHtml(entry.message) + '</td>';
        return tr;
    }

    function poll() {
        if (document.hidden) {
            return;
        }

        var params = new URLSearchParams();
        Object.keys(currentFilters).forEach(function (key) {
            var value = currentFilters[key];
            if (Array.isArray(value)) {
                value.forEach(function (v) { params.append(key + '[]', v); });
            } else if (value !== '') {
                params.set(key, value);
            }
        });
        params.set('sinceId', lastId);

        fetch('{{ path('log_updates') }}?' + params.toString())
            .then(function (response) { return response.json(); })
            .then(function (data) {
                if (data.entries.length === 0) {
                    return;
                }

                var noEntriesRow = document.getElementById('no-entries-row');
                if (noEntriesRow) {
                    noEntriesRow.remove();
                }

                data.entries.forEach(function (entry) {
                    tbody.insertBefore(buildRow(entry), tbody.firstChild);
                });

                while (tbody.children.length > maxRows) {
                    tbody.removeChild(tbody.lastChild);
                }

                lastId = data.lastId;
                if (countEl) {
                    countEl.textContent = String(parseInt(countEl.textContent, 10) + data.entries.length);
                }
            })
            .catch(function () {
                // Transient failure — the next poll tick will just try again.
            });
    }

    if (toggle) {
        toggle.addEventListener('change', function () {
            if (toggle.checked) {
                indicator.classList.remove('d-none');
                poll();
                pollTimer = setInterval(poll, 3000);
            } else {
                indicator.classList.add('d-none');
                if (pollTimer) {
                    clearInterval(pollTimer);
                    pollTimer = null;
                }
            }
        });
    }
})();
</script>
{% endif %}
{% endblock %}
