APP_ENV=dev
APP_SECRET=changeme

DATABASE_URL="mysql://dash:changeme@db:3306/dashlog?serverVersion=8.0&charset=utf8mb4"

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

DEFAULT_URI=https://localhost

APP_ENCRYPTION_KEY=changeme

# Size, in minutes, of the windows incoming log lines are batched into before
# being written to storage as a single object. Must evenly divide 60.
LOG_BATCH_WINDOW_MINUTES=15

###> symfony/web-profiler-bundle ###
VAR_DUMPER_SERVER=tcp://127.0.0.1:9912
